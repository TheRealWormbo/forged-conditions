{
	"schemaVersion": 1,
	"id": "forged-conditions",
	"version": "${version}",
	"name": "Forged Conditions",
	"description": "A datagen add-on that translates Fabric load conditions to NeoForge data load conditions and stores both in generated files.",
	"authors": [
		"Wormbo"
	],
	"contact": {
		"issues": "https://github.com/TheRealWormbo/forged-conditions/issues",
		"sources": "https://github.com/TheRealWormbo/forged-conditions"
	},
	"license": "CC-0",
	"icon": "assets/forged-conditions/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.wormbo.forgedconditions.ForgedConditions"
		],
		"fabric-datagen": [
			"de.wormbo.forgedconditions.ForgedConditionsExampleDataGenerator"
		]
	},
	"mixins": [
		"forged-conditions.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}